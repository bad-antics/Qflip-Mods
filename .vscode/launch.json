{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Run app.py",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/flipper-pineapple-manager/app.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/flipper-pineapple-manager",
      "args": []
    },
    {
      "name": "Python: Flask (module)",
      "type": "python",
      "request": "launch",
      "module": "flask",
      "args": ["run", "--no-debugger", "--no-reload", "--host=0.0.0.0", "--port=5000"],
      "env": {
        "FLASK_APP": "app.py",
        "FLASK_ENV": "development"
      },
      "cwd": "${workspaceFolder}/flipper-pineapple-manager",
      "console": "integratedTerminal",
      "jinja": true
    }
  ]
}